// ============================================================================
// TMS Культтовари Глобал — синхронизация СТАТУСОВ документов из нашей TMS.
// Замена Tocan-обработки (exportAPILogist.php). Логика ЗагрузитьДанные
// сохранена 1-в-1, изменены только транспорт (наша TMS) и поиск рейса.
//
// Реквизит обработки: ДатаСинхронизации (как у Tocan-версии).
//
// Настройки — те же периодические реквизиты объекта "tms.kultukr":
//   server, port, proxy_login, proxy_password (Access List NPM), login, password
//
// Протокол:
//   GET /api/1c/auth?login=&password=                      -> SECURITY_KEY (сессия 24ч)
//   GET /api/1c/export?key=&start_date=&end_date=          -> TRIP* с фактами
//
// STATUS_POINT (семантика Tocan, отдает TMS v34+):
//   склад-выезд: 4 после «Виїхав на маршрут» (триггер СтатусаСоСклада), иначе 1
//   точка:       5 = відмова водія, 4 = поїхав (доставлено), 2 = на точці, 1 = план
//   статус 6 (частично) наша TMS не отдает — в кабинете водителя нет
//   частичной доставки; маппинг оставлен на будущее.
//
// Отличия от Tocan-версии (помечены // TMS в коде):
//   1. Kult_ID рейса ищется с префиксом "TMS_" (так их создает загрузка рейсов).
//   2. Убрана проверка ВидДоставки = "Собственный транспорт": рейсы TMS
//      находятся только по префиксу TMS_, чужие документы не зацепим, а сама
//      загрузка рейсов из TMS ВидДоставки пока не заполняет.
//   3. Авторизация и HTTP — напрямую с прокси-логином NPM и OpenSSL
//      (TRIO_Интеграция_TMS.ВернутьSECURITY_KEY не умеет basic-auth прокси).
// ============================================================================

Перем СоответствиеСтатусовЗаданияТранспорта;
Перем СоответствиеСтатусовЗаказаПокупателя;
Перем СоответствиеСтатусовСтрокЗаказаПокупателя;
Перем СписокСтатусовИсключений;


// ---------- TMS: настройки и HTTP ----------

Функция TMS_Настройка(Имя)
	Возврат TRIO_УправлениеФункционалом.ВернутьЗначенияПериодическогоРеквизита(ТекущаяДата(), "tms.kultukr", Имя);
КонецФункции

Функция TMS_Соединение()
	Сервер = TMS_Настройка("server");
	Порт   = TMS_Настройка("port");
	Если НЕ ЗначениеЗаполнено(Порт) Тогда
		Порт = 443;
	КонецЕсли;
	Возврат Новый HTTPСоединение(Сервер, Число(Порт),
		TMS_Настройка("proxy_login"), TMS_Настройка("proxy_password"),
		, , Новый ЗащищенноеСоединениеOpenSSL);
КонецФункции

Функция TMS_ПолучитьXML(Путь)
	ФайлРезультата = ПолучитьИмяВременногоФайла(".xml");
	Соединение = TMS_Соединение();
	Соединение.Получить(Путь, ФайлРезультата);
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлРезультата);
	Данные = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	УдалитьФайлы(ФайлРезультата);
	Возврат Данные;
КонецФункции

Функция TMS_ВернутьSECURITY_KEY()
	Данные = TMS_ПолучитьXML("/api/1c/auth?login=" + TMS_Настройка("login")
		+ "&password=" + TMS_Настройка("password"));
	Если Строка(Данные.ERROR) = "0" Тогда
		Возврат Строка(Данные.MESSAGE.SECURITY_KEY);
	Иначе
		Сообщить("TMS: помилка авторизації: " + Строка(Данные.ERROR_MESSAGE));
		Возврат "";
	КонецЕсли;
КонецФункции


// ---------- синхронизация статусов ----------

Процедура ВыполнитьСинхронизациюСтатусов() Экспорт

	Если НЕ ЗначениеЗаполнено(ДатаСинхронизации) Тогда
		ДатаСинхронизации = ТекущаяДата();
	КонецЕсли;

	SECURITY_KEY = TMS_ВернутьSECURITY_KEY();
	Если НЕ ЗначениеЗаполнено(SECURITY_KEY) Тогда
		Возврат;
	КонецЕсли;

	Данные_ЧтениеXML = TMS_ПолучитьXML("/api/1c/export?key=" + SECURITY_KEY
		+ "&start_date=" + Формат(ДатаСинхронизации, "ДФ=yyyy-MM-dd")
		+ "&end_date="   + Формат(ДатаСинхронизации, "ДФ=yyyy-MM-dd"));

	МассивДанных = TRIO_Интеграция_TMS.ВернутьСписокТегов("TRIP", Данные_ЧтениеXML);

	// маппинги статусов — идентичны Tocan-версии (те же GUID справочника)
	СоответствиеСтатусовЗаданияТранспорта = Новый Соответствие;
	СоответствиеСтатусовЗаданияТранспорта.Вставить("2", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("d817dde1-9f26-11e9-8115-000c2994ecf6"))); // Автомобиль в пути (2)
	СоответствиеСтатусовЗаданияТранспорта.Вставить("4", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("f465bfb2-9f26-11e9-8115-000c2994ecf6"))); // Доставка выполнена (4)
	СоответствиеСтатусовЗаданияТранспорта.Вставить("5", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("fddc3234-9f26-11e9-8115-000c2994ecf6"))); // Доставка отменена (5)
	СоответствиеСтатусовЗаданияТранспорта.Вставить("6", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("0955a6b7-9f27-11e9-8115-000c2994ecf6"))); // Доставлен частично (6)

	СоответствиеСтатусовЗаказаПокупателя = Новый Соответствие;
	СоответствиеСтатусовЗаказаПокупателя.Вставить("2", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("e3cdfa72-0262-11ea-811a-000c2994ecf6"))); // Доставляется (7)
	СоответствиеСтатусовЗаказаПокупателя.Вставить("4", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("00b6e313-0263-11ea-811a-000c2994ecf6"))); // Выполнен (10)
	СоответствиеСтатусовЗаказаПокупателя.Вставить("5", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("f6bae705-0262-11ea-811a-000c2994ecf6"))); // Не доставлен (9)
	СоответствиеСтатусовЗаказаПокупателя.Вставить("6", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("d5f6cc22-1041-11e9-80f0-000c29a80dde"))); // Выполнен частично (11)

	СоответствиеСтатусовСтрокЗаказаПокупателя = Новый Соответствие;
	СоответствиеСтатусовСтрокЗаказаПокупателя.Вставить("2", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("3688f426-1042-11e9-80f0-000c29a80dde"))); // В пути
	СоответствиеСтатусовСтрокЗаказаПокупателя.Вставить("4", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("3f5172cd-2c59-11ee-ab83-005056af22e0"))); // Доставлен
	СоответствиеСтатусовСтрокЗаказаПокупателя.Вставить("5", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("47374fa9-2c59-11ee-ab83-005056af22e0"))); // Не доставлен
	СоответствиеСтатусовСтрокЗаказаПокупателя.Вставить("6", Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("5f7cb5dc-2c59-11ee-ab83-005056af22e0"))); // Частично доставлен

	СписокСтатусовИсключений = Новый СписокЗначений;
	СписокСтатусовИсключений.Добавить(Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("f465bfb2-9f26-11e9-8115-000c2994ecf6"))); // Доставка выполнена (4)
	СписокСтатусовИсключений.Добавить(Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("00b6e313-0263-11ea-811a-000c2994ecf6"))); // Выполнен (10)
	СписокСтатусовИсключений.Добавить(Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(
	Новый УникальныйИдентификатор("95c8ddc2-2a81-11ee-ba86-005056afce30"))); // Доставлен

	Если ТипЗнч(МассивДанных) = Тип("СписокXDTO") Тогда
		Для Каждого СтрокаДанных из МассивДанных Цикл
			ЗагрузитьДанные(СтрокаДанных);
		КонецЦикла;
	ИначеЕсли ТипЗнч(МассивДанных) = Тип("ОбъектXDTO") Тогда
		ЗагрузитьДанные(МассивДанных);
	Иначе
		Если НЕ Данные_ЧтениеXML.ERROR = "0" Тогда
			Сообщить(Данные_ЧтениеXML.ERROR_MESSAGE);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьДанные(СтрокаДанных)

	// TMS: рейсы нашей TMS хранятся с префиксом (см. TMS_ЗагрузитьРейсИЗ_XML)
	Kult_ID = "TMS_" + Строка(СтрокаДанных.TRIP_CODE);
	ДокРейсСсылка = Документы.Kult_РейсТранспорта.НайтиПоРеквизиту("Kult_ID", Kult_ID);

	Если НЕ ЗначениеЗаполнено(ДокРейсСсылка) Тогда
		Возврат;
	КонецЕсли;

	// TMS: проверка ВидДоставки убрана — по префиксу TMS_ находятся только
	// наши рейсы, а ВидДоставки в них пока не заполняется загрузкой.

	ОбДок = ДокРейсСсылка.ПолучитьОбъект();
	ДокИзменен = Ложь;

	Если НЕ ОбДок.Заблокирован() Тогда
		Попытка
			ОбДок.Заблокировать();
		Исключение
			ОбДок = Неопределено;
		КонецПопытки;
	Иначе
		ОбДок = Неопределено;
	КонецЕсли;

	МассивДанных = TRIO_Интеграция_TMS.ВернутьСписокТегов("ORDER", СтрокаДанных.ORDERS);

	СтатусСоСклада = Неопределено;

	Для каждого Точка из МассивДанных цикл
		Поиск_Склада  = Справочники.Склады.НайтиПоКоду(Точка.CODE, Истина);
		НовыйСтатус = СоответствиеСтатусовЗаданияТранспорта.Получить("" + СокрЛП(Точка.STATUS_POINT));
		НовыйСтатусЗаказа = СоответствиеСтатусовЗаказаПокупателя.Получить("" + СокрЛП(Точка.STATUS_POINT));
		НовыйСтатусСтрЗаказа = СоответствиеСтатусовСтрокЗаказаПокупателя.Получить("" + СокрЛП(Точка.STATUS_POINT));

		Если НовыйСтатус = Неопределено И СтатусСоСклада = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если НовыйСтатус = Неопределено И СтатусСоСклада <> Неопределено Тогда
			НовыйСтатус = СоответствиеСтатусовЗаданияТранспорта.Получить("2");
			НовыйСтатусЗаказа = СоответствиеСтатусовЗаказаПокупателя.Получить("2");
			НовыйСтатусСтрЗаказа = СоответствиеСтатусовСтрокЗаказаПокупателя.Получить("2");
		КонецЕсли;

		Если НовыйСтатус = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(Поиск_Склада) И СтатусСоСклада = Неопределено Тогда
			// склад-выезд со STATUS_POINT=4 = водитель отметил «Виїхав на маршрут»
			Если ("" + СокрЛП(Точка.STATUS_POINT)) = "4" Тогда
				СтатусСоСклада = СоответствиеСтатусовЗаданияТранспорта.Получить("" + СокрЛП(Точка.STATUS_POINT));
			КонецЕсли;
		ИначеЕсли СтатусСоСклада <> Неопределено Тогда
			ЗаданиеТранспорта = Документы.Kult_ЗаданиеТранспорта.НайтиПоНомеру(Точка.CODE, ДатаСинхронизации);

			Если ЗаданиеТранспорта.Пустая() Тогда
				Запрос = Новый Запрос;
				Запрос.Текст =
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	Kult_ЗаданиеТранспорта.Ссылка
				|ИЗ
				|	Документ.Kult_ЗаданиеТранспорта КАК Kult_ЗаданиеТранспорта
				|ГДЕ
				|	Kult_ЗаданиеТранспорта.Номер = &Номер
				|	И Kult_ЗаданиеТранспорта.Дата МЕЖДУ &ДатаНач И &ДатаКон
				|	И НЕ Kult_ЗаданиеТранспорта.ПометкаУдаления";
				Запрос.УстановитьПараметр("Номер", Точка.CODE);
				Запрос.УстановитьПараметр("ДатаНач", (НачалоДня(ТекущаяДата()) - 60 * 60 * 24 * 30));
				Запрос.УстановитьПараметр("ДатаКон", КонецДня(ТекущаяДата()));
				тбРез = Запрос.Выполнить().Выгрузить();

				Если тбРез.Количество() Тогда
					ПерваяЗапись = тбРез.Получить(0);
					ЗаданиеТранспорта = ПерваяЗапись.Ссылка;
				КонецЕсли;
			КонецЕсли;

			СтрНайденныйДокЗТ = ДокРейсСсылка.Заказы.Найти(ЗаданиеТранспорта, "ЗаказНаДоставку");

			Если ЗначениеЗаполнено(ЗаданиеТранспорта) И СтрНайденныйДокЗТ <> Неопределено Тогда
				Если ЗаданиеТранспорта.Kult_СтатусЗаданияТранспорта <> НовыйСтатус
					И СписокСтатусовИсключений.НайтиПоЗначению(ЗаданиеТранспорта.Kult_СтатусЗаданияТранспорта) = Неопределено Тогда
					TRIO_Привелигированный.ЗаписатьСтатусДокумента(ЗаданиеТранспорта,
					НовыйСтатус,
					ЗаданиеТранспорта.Kult_СтатусЗаданияТранспорта,
					глЗначениеПеременной("глТекущийПользователь"),
					"Синхронізація статуса по API TMS Культтовари",
					ТекущаяДата(),
					Истина);
				КонецЕсли;

				МассивЗаказов = Новый Массив;

				Для Каждого Стр ИЗ ЗаданиеТранспорта.ТаблицаЗаданий Цикл
					Если ТипЗнч(Стр.Заказ) = Тип("ДокументСсылка.ЗаказПокупателя") И Стр.Заказ.Kult_ОтражатьВУправленческомУчете Тогда
						Если Стр.Заказ.Kult_СтатусЗаказаПокупателя <> НовыйСтатусЗаказа
							И СписокСтатусовИсключений.НайтиПоЗначению(Стр.Заказ.Kult_СтатусЗаказаПокупателя) = Неопределено Тогда
							TRIO_Привелигированный.ЗаписатьСтатусДокумента(Стр.Заказ,
							НовыйСтатусЗаказа,
							Стр.Заказ.Kult_СтатусЗаказаПокупателя,
							глЗначениеПеременной("глТекущийПользователь"),
							"Синхронізація статуса по API TMS Культтовари",
							ТекущаяДата(),
							Истина);

							МассивЗаказов.Добавить(Стр.Заказ);
						КонецЕсли;

						Для Каждого СтрТовар ИЗ Стр.Заказ.Kult_ТоварыСУчетомКорректировок Цикл
							Если СтрТовар.Kult_СостояниеСтроки <> НовыйСтатусСтрЗаказа
								И СписокСтатусовИсключений.НайтиПоЗначению(СтрТовар.Kult_СостояниеСтроки) = Неопределено Тогда
								TRIO_Привелигированный.ЗаписатьСтатусСтрокиДокумента(Стр.Заказ,
								НовыйСтатусСтрЗаказа,
								СтрТовар.Kult_СостояниеСтроки,
								СтрТовар.Номенклатура,
								СтрТовар.ХарактеристикаНоменклатуры,
								СтрТовар.Kult_ИдентификаторСтрокиЗаказаПокупателя,
								глЗначениеПеременной("глТекущийПользователь"),
								"Синхронізація статуса по API TMS Культтовари",
								ТекущаяДата(),
								"Kult_ТоварыСУчетомКорректировок",
								,
								Истина);
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;

				profi_ПроцедурыОбмена.ИзменениеСтатусаЗаказаОтправкаУведомлений(МассивЗаказов, ЗаданиеТранспорта, ДокРейсСсылка, НовыйСтатусЗаказа);

				Если ОбДок <> Неопределено Тогда
					НайденныеСтроки = ОбДок.Заказы.НайтиСтроки(Новый Структура("ЗаказНаДоставку", ЗаданиеТранспорта));

					Для Каждого НСтр ИЗ НайденныеСтроки Цикл
						НСтр.СтатусДоставки = НовыйСтатус;
						ДокИзменен = Истина;
					КонецЦикла;
				Иначе
					МенеджерЗаписи = РегистрыСведений.profi_ЗаписатьСтатусыДляОткрытогоДокумента.СоздатьМенеджерЗаписи();
					МенеджерЗаписи.Ссылка = ДокРейсСсылка;
					МенеджерЗаписи.ИдентификаторДок = ЗаданиеТранспорта;
					МенеджерЗаписи.ТекущийСтатус = НовыйСтатус;
					МенеджерЗаписи.ОбновитьВФорме = Истина;
					МенеджерЗаписи.Записать();
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

	Если ОбДок <> Неопределено Тогда
		ОбДок.ДополнительныеСвойства.Вставить("profi_ТолькоИзменениеСтатусаВТаблице", Истина);

		Если ДокИзменен Тогда
			Если ОбДок.Проведен Тогда
				Попытка
					ОбДок.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
				Исключение
					ОбДок.Записать(РежимЗаписиДокумента.Запись);
				КонецПопытки;
			Иначе
				ОбДок.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
		КонецЕсли;

