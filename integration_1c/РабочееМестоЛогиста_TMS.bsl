// ============================================================================
// TMS Культтовари Глобал — синхронизация с собственной TMS (замена Tocan).
// Добавить в модуль формы "Рабочее место логиста" НЕ УДАЛЯЯ старый код Tocan.
//
// Новые кнопки командных панелей (создать в конфигураторе):
//   Заказы:  "Передать все в TMS"        -> КоманднаяПанельЗаказыПередатьВсеВTMS
//            "Передать выделенное в TMS" -> КоманднаяПанельЗаказыПередатьВыделенноеВTMS
//   Рейсы:   "Загрузить рейсы из TMS"    -> КоманднаяПанельРейсовЗагрузитьРейсыИзTMS
//
// Настройки (периодические реквизиты, объект "tms.kultukr" — по аналогии
// с "s5.vvtrack.com"):
//   server   = 128.140.34.164        (хост нашей TMS, без http://)
//   port     = 80                    (или порт, на котором проксируется api)
//   login    = 1c                    (TMS_1C_LOGIN на сервере)
//   password = kultukr-1c            (TMS_1C_PASSWORD на сервере)
//
// Протокол (наша TMS повторяет схему Tocan):
//   GET  /api/1c/auth?login=&password=            -> ERROR, MESSAGE.SECURITY_KEY (сессия 24ч)
//   POST /api/1c/import?key=&project=&name_project=&date_project=  (XML ORDERS)
//        ответ: MESSAGE.SECURITY_KEY = ключ ПРОЕКТА (хранить, для обновления и выгрузки)
//   GET  /api/1c/export?key=<ключ проекта>        -> ERROR, TRIP*  (рейсы проекта)
// ============================================================================

// ---------- настройки и HTTP ----------

Функция TMS_Настройка(Имя)
	Возврат TRIO_УправлениеФункционалом.ВернутьЗначенияПериодическогоРеквизита(ТекущаяДата(), "tms.kultukr", Имя);
КонецФункции

Функция TMS_Соединение()
	Сервер = TMS_Настройка("server");
	Порт   = TMS_Настройка("port");
	Если НЕ ЗначениеЗаполнено(Порт) Тогда
		Порт = 80;
	КонецЕсли;
	// http без OpenSSL; если TMS за https-прокси — добавить Новый ЗащищенноеСоединениеOpenSSL последним параметром
	Возврат Новый HTTPСоединение(Сервер, Число(Порт));
КонецФункции

// GET с разбором XML-ответа в ОбъектXDTO
Функция TMS_ПолучитьXML(Путь)
	ФайлРезультата = ПолучитьИмяВременногоФайла(".xml");
	Соединение = TMS_Соединение();
	Соединение.Получить(Путь, ФайлРезультата);
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлРезультата);
	Данные = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();
	УдалитьФайлы(ФайлРезультата);
	Возврат Данные;
КонецФункции

// список значений свойства XDTO (свойство может быть списком, объектом или отсутствовать)
Функция TMS_СписокТегов(Имя, Данные)
	Массив = Новый Массив;
	Если Данные = Неопределено Тогда
		Возврат Массив;
	КонецЕсли;
	Попытка
		Значение = Данные[Имя];
	Исключение
		Возврат Массив;
	КонецПопытки;
	Если ТипЗнч(Значение) = Тип("СписокXDTO") Тогда
		Для Каждого Эл Из Значение Цикл
			Массив.Добавить(Эл);
		КонецЦикла;
	ИначеЕсли Значение <> Неопределено Тогда
		Массив.Добавить(Значение);
	КонецЕсли;
	Возврат Массив;
КонецФункции

// "yyyy-MM-ddTHH:mm:ss" -> Дата (пустая строка -> Дата(1,1,1))
Функция TMS_ПрочитатьДату(Значение)
	Стр = СокрЛП(Строка(Значение));
	Если СтрДлина(Стр) < 19 Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Попытка
		Возврат Дата(
			Число(Сред(Стр, 1, 4)), Число(Сред(Стр, 6, 2)), Число(Сред(Стр, 9, 2)),
			Число(Сред(Стр, 12, 2)), Число(Сред(Стр, 15, 2)), Число(Сред(Стр, 18, 2)));
	Исключение
		Возврат Дата(1, 1, 1);
	КонецПопытки;
КонецФункции

// сессионный ключ (авторизация логин/пароль)
Функция TMS_ВернутьSECURITY_KEY()
	login    = TMS_Настройка("login");
	password = TMS_Настройка("password");
	Данные = TMS_ПолучитьXML("/api/1c/auth?login=" + login + "&password=" + password);
	Если Строка(Данные.ERROR) = "0" Тогда
		Возврат Строка(Данные.MESSAGE.SECURITY_KEY);
	Иначе
		Предупреждение("TMS: помилка авторизації: " + Строка(Данные.ERROR_MESSAGE));
		Возврат "";
	КонецЕсли;
КонецФункции

// ---------- ПЕРЕДАЧА ЗАДАНИЙ В TMS ----------

Процедура КоманднаяПанельЗаказыПередатьВсеВTMS(Кнопка)
	ТаблицаДанных = Заказы.Выгрузить();
	TMS_ВыполнитьСинхронизацию(ТаблицаДанных);
КонецПроцедуры

Процедура КоманднаяПанельЗаказыПередатьВыделенноеВTMS(Кнопка)
	ТаблицаДанных = Заказы.Выгрузить();
	ТаблицаДанных.Очистить();
	Для Каждого СтрокаДанныхЗаказа Из ЭлементыФормы.Заказы.ВыделенныеСтроки Цикл
		НоваяСтрока = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанныхЗаказа);
	КонецЦикла;
	TMS_ВыполнитьСинхронизацию(ТаблицаДанных);
КонецПроцедуры

Процедура TMS_ВыполнитьСинхронизацию(ТаблицаЗаказов)

	Если НЕ ЗначениеЗаполнено(ДатаПланирования) ИЛИ НЕ ЗначениеЗаполнено(Подразделение) Тогда
		Предупреждение("Необходимо заполнить дату планирования и подразделение!");
		Возврат;
	КонецЕсли;

	// ключ проекта на дату+подразделение (аналог ProjectImport у Tocan)
	КлючПроекта  = TRIO_УправлениеФункционалом.ВернутьЗначенияПериодическогоРеквизита(ДатаПланирования, "tms.kultukr", "ProjectTMS_" + Строка(Подразделение) + "_" + Строка(ДатаПланирования));
	ИндексПроекта = TRIO_УправлениеФункционалом.ВернутьЗначенияПериодическогоРеквизита(ДатаПланирования, "tms.kultukr", "ProjectTMS_Index_" + Строка(Подразделение) + "_" + Строка(ДатаПланирования));

	Если ЗначениеЗаполнено(КлючПроекта) Тогда
		Ответ = Вопрос("Обновить проект планирования TMS (Да) или создать новый (Нет)?", РежимДиалогаВопрос.ДаНетОтмена);
		Если Ответ = КодВозвратаДиалога.Отмена Тогда
			Возврат;
		ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
			КлючПроекта = "";
			ИндексПроекта = ИндексПроекта + 1;
		КонецЕсли;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ИндексПроекта) Тогда
		ИндексПроекта = 1;
	КонецЕсли;

	SECURITY_KEY = TMS_ВернутьSECURITY_KEY();
	Если НЕ ЗначениеЗаполнено(SECURITY_KEY) Тогда
		Возврат;
	КонецЕсли;

	ТаблицаЗаказов.Колонки.Добавить("ОтказВыгрузки");

	Если ТаблицаЗаказов.Количество() = 0 Тогда
		Предупреждение("Нет данных для синхронизации!");
		Возврат;
	КонецЕсли;

	// -------- XML заказов (схема идентична Tocan) --------
	ИмяФайлаЗапроса = ПолучитьИмяВременногоФайла(".xml");
	ОбъектXML = Новый ЗаписьXML;
	ОбъектXML.ОткрытьФайл(ИмяФайлаЗапроса, "UTF-8");
	ОбъектXML.ЗаписатьОбъявлениеXML();
	ОбъектXML.ЗаписатьНачалоЭлемента("ORDERS");

	Для Каждого СтрокаДанныхЗаказа Из ТаблицаЗаказов Цикл

		КодАдресаДоставки = ВернутьКодАдресаДоставки(СтрокаДанныхЗаказа.Ссылка.Контрагент, СтрокаДанныхЗаказа.Ссылка.АдресДоставки);
		Если НЕ ЗначениеЗаполнено(КодАдресаДоставки) Тогда
			Сообщить("Документ " + Строка(СтрокаДанныхЗаказа.Ссылка) + ", не выгружен из-за ошибки в адресе!");
			СтрокаДанныхЗаказа.ОтказВыгрузки = Истина;
			Продолжить;
		Иначе
			СтрокаДанныхЗаказа.ОтказВыгрузки = Ложь;
		КонецЕсли;

		ОбъектXML.ЗаписатьНачалоЭлемента("ORDER");

		ЗаписатьТекстовойУзел(ОбъектXML, "CODE",           СтрокаДанныхЗаказа.Ссылка.Номер);
		ЗаписатьТекстовойУзел(ОбъектXML, "NAME",           ОбщегоНазначения.СформироватьЗаголовокДокумента(СтрокаДанныхЗаказа.Ссылка, ?(СтрокаДанныхЗаказа.Ссылка.ВидОперации = Перечисления.Kult_ВидыОперацийЗаданиеТранспорта.ДоставкаГруза, "Доставка груза ", "Забор груза ")));
		ЗаписатьТекстовойУзел(ОбъектXML, "WAREHOUSE_CODE", СтрокаДанныхЗаказа.Ссылка.Склад.Код);
		ЗаписатьТекстовойУзел(ОбъектXML, "ADDRESS",        СтрокаДанныхЗаказа.Ссылка.АдресДоставки);
		ЗаписатьТекстовойУзел(ОбъектXML, "GeoX",           СтрокаДанныхЗаказа.Ссылка.Широта);
		ЗаписатьТекстовойУзел(ОбъектXML, "GeoY",           СтрокаДанныхЗаказа.Ссылка.Долгота);
		ЗаписатьТекстовойУзел(ОбъектXML, "COMMENTS",       СтрокаДанныхЗаказа.Ссылка.Комментарий);
		ЗаписатьТекстовойУзел(ОбъектXML, "COMMENTS_SHOP",  СтрокаДанныхЗаказа.Ссылка.ДополнениеКАдресуДоставки);
		ЗаписатьТекстовойУзел(ОбъектXML, "CLIENT_CODE",    СтрокаДанныхЗаказа.Ссылка.Контрагент.Код);
		ЗаписатьТекстовойУзел(ОбъектXML, "CLIENT_NAME",    СтрокаДанныхЗаказа.Ссылка.Контрагент.Наименование);
		ЗаписатьТекстовойУзел(ОбъектXML, "SHOP_CODE",      КодАдресаДоставки);
		ЗаписатьТекстовойУзел(ОбъектXML, "SHOP_NAME",      СтрокаДанныхЗаказа.Ссылка.Контрагент.Наименование + " / " + СтрокаДанныхЗаказа.Ссылка.АдресДоставки);
		ЗаписатьТекстовойУзел(ОбъектXML, "DELIVERY_DATE",  Формат(СтрокаДанныхЗаказа.Ссылка.ДатаВыполнения, "ДФ=yyyy-MM-dd"));
		ЗаписатьТекстовойУзел(ОбъектXML, "SHOP_WORK_TIME", Формат(СтрокаДанныхЗаказа.Ссылка.ВремяПрибытияС, "ДФ=ЧЧ:мм") + "-" + Формат(СтрокаДанныхЗаказа.Ссылка.ВремяПрибытияПо, "ДФ=ЧЧ:мм"));

		ПочатокПерерви = СтрокаДанныхЗаказа.Ссылка.ВремяПерерываС;
		КінецьПерерви  = СтрокаДанныхЗаказа.Ссылка.ВремяПерерываПо;
		Если ЗначениеЗаполнено(ПочатокПерерви) И ЗначениеЗаполнено(КінецьПерерви) Тогда
			ЗаписатьТекстовойУзел(ОбъектXML, "SHOP_DINNER_TIME", Формат(ПочатокПерерви, "ДФ=ЧЧ:мм") + "-" + Формат(КінецьПерерви, "ДФ=ЧЧ:мм"), Ложь);
		КонецЕсли;

		ЗаписатьТекстовойУзел(ОбъектXML, "UNLOAD_TIME",    Формат(СтрокаДанныхЗаказа.Ссылка.ДлительностьРазгрузки, "ДФ=мм"));
		ЗаписатьТекстовойУзел(ОбъектXML, "PRIORITY",       СтрокаДанныхЗаказа.Ссылка.Приоритет);

		ОбъектXML.ЗаписатьНачалоЭлемента("PRODUCTS");
		Вес   = СтрокаДанныхЗаказа.Ссылка.ВесДокумента;
		Объем = СтрокаДанныхЗаказа.Ссылка.ОбъемДокумента;
		ЭтоЗабор = (СтрокаДанныхЗаказа.Ссылка.ВидОперации = Перечисления.Kult_ВидыОперацийЗаданиеТранспорта.ЗаборГруза);

		Если СтрокаДанныхЗаказа.Ссылка.ТаблицаЗаданий.Количество() = 0 Тогда
			ОбъектXML.ЗаписатьНачалоЭлемента("PRODUCT");
			ОбъектXML.ЗаписатьАтрибут("WEIGHT", СтрЗаменить(Строка(?(ЭтоЗабор И Вес > 0, -1, 1) * Вес), ",", "."));
			ОбъектXML.ЗаписатьАтрибут("VOLUME", СтрЗаменить(Строка(?(ЭтоЗабор И Объем > 0, -1, 1) * Объем), ",", "."));
			ОбъектXML.ЗаписатьАтрибут("PROD_NAME", ?(ЭтоЗабор, "Забор товаров", "Доставка товаров"));
			ОбъектXML.ЗаписатьАтрибут("PROD_CODE", ?(ЭтоЗабор, "00000000003", "00000000001"));
			ОбъектXML.ЗаписатьАтрибут("COST", "0");
			ОбъектXML.ЗаписатьАтрибут("COUNT", ?(ЭтоЗабор, "-1", "1"));
			ОбъектXML.ЗаписатьКонецЭлемента();
		Иначе
			Для Каждого СтрокаДоставки Из СтрокаДанныхЗаказа.Ссылка.ТаблицаЗаданий Цикл
				ОбъектXML.ЗаписатьНачалоЭлемента("PRODUCT");
				ОбъектXML.ЗаписатьАтрибут("WEIGHT", СтрЗаменить(Строка(?(ЭтоЗабор И СтрокаДоставки.ВесДокумента > 0, -1, 1) * СтрокаДоставки.ВесДокумента), ",", "."));
				ОбъектXML.ЗаписатьАтрибут("VOLUME", СтрЗаменить(Строка(?(ЭтоЗабор И СтрокаДоставки.ОбъемДокумента > 0, -1, 1) * СтрокаДоставки.ОбъемДокумента), ",", "."));
				ОбъектXML.ЗаписатьАтрибут("PROD_NAME", СтрокаДоставки.ВидЗадания.Наименование);
				ОбъектXML.ЗаписатьАтрибут("PROD_CODE", СтрокаДоставки.ВидЗадания.Код);
				ОбъектXML.ЗаписатьАтрибут("COST", "0");
				ОбъектXML.ЗаписатьАтрибут("COUNT", ?(ЭтоЗабор, "-1", "1"));
				ОбъектXML.ЗаписатьКонецЭлемента();
			КонецЦикла;
		КонецЕсли;
		ОбъектXML.ЗаписатьКонецЭлемента();  // PRODUCTS

		ЗаписатьТекстовойУзел(ОбъектXML, "TOTAL_COST", "0");
		ЗаписатьТекстовойУзел(ОбъектXML, "PHONE",      СтрокаДанныхЗаказа.Ссылка.ТелефонКонтактногоЛица);

		ОбъектXML.ЗаписатьКонецЭлемента();  // ORDER
	КонецЦикла;

	ОбъектXML.ЗаписатьКонецЭлемента();  // ORDERS
	ОбъектXML.Закрыть();

	// -------- отправка --------
	Путь = "/api/1c/import?key=" + SECURITY_KEY
		+ ?(ЗначениеЗаполнено(КлючПроекта),
			"&project=" + КлючПроекта,
			"&name_project=" + Формат(ДатаПланирования, "ДФ=dd-MM-yy") + "_" + Строка(Подразделение) + "_" + Строка(ИндексПроекта)
			+ "&date_project=" + Формат(ДатаПланирования, "ДФ=yyyy-MM-dd"));

	ФайлРезультата = ПолучитьИмяВременногоФайла(".xml");
	Соединение = TMS_Соединение();
	Соединение.ОтправитьДляОбработки(ИмяФайлаЗапроса, Путь, ФайлРезультата);

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ФайлРезультата);
	Данные = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	ЧтениеXML.Закрыть();

	Если НЕ Строка(Данные.ERROR) = "0" Тогда
		Предупреждение("TMS: ошибка передачи данных: " + Строка(Данные.ERROR_MESSAGE));
	Иначе
		Если НЕ ЗначениеЗаполнено(КлючПроекта) Тогда
			// сервер вернул ключ нового проекта — сохраняем для обновлений и выгрузки рейсов
			КлючПроекта = Строка(Данные.MESSAGE.SECURITY_KEY);
			TRIO_Привелигированный.ЗаписатьДанныеПериодическогоРеквизита(ТекущаяДата(), "tms.kultukr", "ProjectTMS_" + Строка(Подразделение) + "_" + Строка(ДатаПланирования), КлючПроекта);
			TRIO_Привелигированный.ЗаписатьДанныеПериодическогоРеквизита(ТекущаяДата(), "tms.kultukr", "ProjectTMS_Index_" + Строка(Подразделение) + "_" + Строка(ДатаПланирования), ИндексПроекта);
		КонецЕсли;

		Статус_Передан = Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(Новый УникальныйИдентификатор("ab283ce8-9f20-11e9-8115-000c2994ecf6"));
		Для Каждого СтрокаДанныхЗаказа Из ТаблицаЗаказов Цикл
			Если СтрокаДанныхЗаказа.ОтказВыгрузки = Ложь Тогда
				TRIO_Привелигированный.ЗаписатьСтатусДокумента(СтрокаДанныхЗаказа.Ссылка, Статус_Передан, СтрокаДанныхЗаказа.Ссылка.Kult_СтатусЗаданияТранспорта, глЗначениеПеременной("глТекущийПользователь"), , ТекущаяДата(), Истина);
			КонецЕсли;
		КонецЦикла;

		Предупреждение("Задания успешно переданы в TMS! (" + Строка(Данные.MESSAGE.PARSED) + " заявок)");
	КонецЕсли;

	УдалитьФайлы(ИмяФайлаЗапроса);
	УдалитьФайлы(ФайлРезультата);

КонецПроцедуры

// ---------- ЗАГРУЗКА РЕЙСОВ ИЗ TMS ----------

Процедура КоманднаяПанельРейсовЗагрузитьРейсыИзTMS(Кнопка)
	TMS_СинхронизироватьРейсы();
КонецПроцедуры

Процедура TMS_СинхронизироватьРейсы()

	Если НЕ ЗначениеЗаполнено(ДатаПланирования) Тогда
		Возврат;
	КонецЕсли;

	// рейсы забираем по ключу ПРОЕКТА (только маршруты этого проекта планирования)
	КлючПроекта = TRIO_УправлениеФункционалом.ВернутьЗначенияПериодическогоРеквизита(ДатаПланирования, "tms.kultukr", "ProjectTMS_" + Строка(Подразделение) + "_" + Строка(ДатаПланирования));
	Если НЕ ЗначениеЗаполнено(КлючПроекта) Тогда
		Предупреждение("Для этой даты и подразделения нет проекта TMS — сначала передайте задания.");
		Возврат;
	КонецЕсли;

	Данные = TMS_ПолучитьXML("/api/1c/export?key=" + КлючПроекта);

	Если НЕ Строка(Данные.ERROR) = "0" Тогда
		Предупреждение("TMS: " + Строка(Данные.ERROR_MESSAGE));
		Возврат;
	КонецЕсли;

	МассивРейсов = TMS_СписокТегов("TRIP", Данные);
	Если МассивРейсов.Количество() = 0 Тогда
		Предупреждение("TMS не вернула ни одного рейса (маршруты еще не рассчитаны?).");
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаДанных Из МассивРейсов Цикл
		TMS_ЗагрузитьРейсИЗ_XML(СтрокаДанных);
	КонецЦикла;

	ОбновитьТаблицы();
	Сообщить("TMS: загружено рейсов: " + Строка(МассивРейсов.Количество()));

КонецПроцедуры

// копия ЗагрузитьРейсИЗ_XML: TRIP_CODE с префиксом TMS_, даты ISO, статусы план
Процедура TMS_ЗагрузитьРейсИЗ_XML(СтрокаДанных)

	Kult_ID        = "TMS_" + Строка(СтрокаДанных.TRIP_CODE);   // префикс — чтобы не пересекаться с Tocan ID
	ПоискДокумента = Документы.Kult_РейсТранспорта.НайтиПоРеквизиту("Kult_ID", Kult_ID);
	Если НЕ ЗначениеЗаполнено(ПоискДокумента) Тогда
		ДокументРейс = Документы.Kult_РейсТранспорта.СоздатьДокумент();
	Иначе
		ДокументРейс = ПоискДокумента.ПолучитьОбъект();
	КонецЕсли;

	ДокументРейс.Kult_ID     = Kult_ID;
	ДокументРейс.Дата        = ДатаПланирования;
	ДокументРейс.Транспорт   = Справочники.Kult_Транспорт.НайтиПоКоду(Строка(СтрокаДанных.CODE_CAR));
	ДокументРейс.Водитель    = Справочники.ФизическиеЛица.НайтиПоКоду(Строка(СтрокаДанных.CODE_DRIVER));
	ДокументРейс.Комментарий = ?(ТипЗнч(СтрокаДанных.COMMENTS) = Тип("Строка"), СокрЛП(СтрокаДанных.COMMENTS), "");
	Попытка
		ДокументРейс.Пробег = Число(СтрЗаменить(Строка(СтрокаДанных.TRIP_DIST_PLAN), ".", ","));
	Исключение
		ДокументРейс.Пробег = 0;
	КонецПопытки;

	ДокументРейс.Возвращение = TMS_ПрочитатьДату(СтрокаДанных.FINISH_TIME_PLAN);
	НачалоРейса              = TMS_ПрочитатьДату(СтрокаДанных.START_TIME_PLAN);
	Если ЗначениеЗаполнено(НачалоРейса) Тогда
		ДокументРейс.Дата = НачалоРейса;
	КонецЕсли;
	Попытка
		ДокументРейс.Вес = Число(СтрЗаменить(Лев(Строка(СтрокаДанных.TRIP_ORDERS_WEIGHT_PLAN), 10), ".", ","));
	Исключение
	КонецПопытки;

	ДокументРейс.Kult_СтатусРейсТранспорта = Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(Новый УникальныйИдентификатор("f391e23a-9ef3-11e9-8115-000c2994ecf6"));

	ДокументРейс.Заказы.Очистить();

	Статус_Заказ_Принят = Справочники.Kult_СтатусыДокументов.ПолучитьСсылку(Новый УникальныйИдентификатор("d06b349d-9f26-11e9-8115-000c2994ecf6"));

	МассивТочек = TMS_СписокТегов("ORDER", СтрокаДанных.ORDERS);
	Для Каждого Точка Из МассивТочек Цикл

		КодТочки = Строка(Точка.CODE);

		// склад?
		Поиск_Склада = Справочники.Склады.НайтиПоКоду(КодТочки);
		Если ЗначениеЗаполнено(Поиск_Склада) Тогда
			НоваяСтрокаЗаказа                          = ДокументРейс.Заказы.Добавить();
			НоваяСтрокаЗаказа.ЗаказНаДоставку          = Поиск_Склада;
			НоваяСтрокаЗаказа.Порядок                  = Точка.IN_TRIP_NUMBER;
			НоваяСтрокаЗаказа.Адрес                    = Поиск_Склада.Kult_Адрес;
			НоваяСтрокаЗаказа.Прибытие                 = TMS_ПрочитатьДату(Точка.DELIVERY_DATE_PLAN);
			Продолжить;
		КонецЕсли;

		// задание транспорта по номеру (окно поиска: -2 месяца, как в актуальной версии Tocan-кода)
		ПоискЗадания = Документы.Kult_ЗаданиеТранспорта.ПустаяСсылка();
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	Kult_ЗаданиеТранспорта.Ссылка
		|ИЗ
		|	Документ.Kult_ЗаданиеТранспорта КАК Kult_ЗаданиеТранспорта
		|ГДЕ
		|	Kult_ЗаданиеТранспорта.Номер = &Номер
		|	И Kult_ЗаданиеТранспорта.Дата >= ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -2)";
		Запрос.УстановитьПараметр("Номер", КодТочки);
		Запрос.УстановитьПараметр("Дата", ДатаПланирования);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПоискЗадания = Выборка.Ссылка;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ПоискЗадания) Тогда
			Сообщить("TMS: задание с номером " + КодТочки + " не найдено — точка пропущена.");
			Продолжить;
		КонецЕсли;

		Если НЕ ЗначениеЗаполнено(ДокументРейс.Подразделение) Тогда
			ДокументРейс.Подразделение = ПоискЗадания.Подразделение;
		КонецЕсли;

		НоваяСтрокаЗаказа                              = ДокументРейс.Заказы.Добавить();
		НоваяСтрокаЗаказа.ЗаказНаДоставку              = ПоискЗадания;
		НоваяСтрокаЗаказа.Порядок                      = Точка.IN_TRIP_NUMBER;
		НоваяСтрокаЗаказа.Адрес                        = ПоискЗадания.АдресДоставки;
		НоваяСтрокаЗаказа.Контрагент                   = ПоискЗадания.Контрагент;
		Попытка
			НоваяСтрокаЗаказа.ПлановоеРасстояниеКТочке = Число(СтрЗаменить(Строка(Точка.PLAN_DIST), ".", ","));
		Исключение
			НоваяСтрокаЗаказа.ПлановоеРасстояниеКТочке = 0;
		КонецПопытки;
		НоваяСтрокаЗаказа.Вес                          = ПоискЗадания.ВесДокумента;
		НоваяСтрокаЗаказа.Объем                        = ПоискЗадания.ОбъемДокумента;
		НоваяСтрокаЗаказа.СуммаДокумента               = ПоискЗадания.СуммаДокумента;
		НоваяСтрокаЗаказа.ОбъемДокументаБумага         = ПоискЗадания.ОбъемДокументаБумага;
		НоваяСтрокаЗаказа.ВесДокументаБумага           = ПоискЗадания.ВесДокументаБумага;
		НоваяСтрокаЗаказа.Прибытие                     = TMS_ПрочитатьДату(Точка.DELIVERY_DATE_PLAN);
		НоваяСтрокаЗаказа.Выезд                        = TMS_ПрочитатьДату(Точка.DELIVERY_OUTDATE_PLAN);
		НоваяСтрокаЗаказа.Стоянка                      = (НоваяСтрокаЗаказа.Выезд - НоваяСтрокаЗаказа.Прибытие) / 60;
		НоваяСтрокаЗаказа.ЗатратыНаКМ                  = ?(ЗначениеЗаполнено(ДокументРейс.Транспорт), ДокументРейс.Транспорт.ЗатратыНаКМ, 0);
		НоваяСтрокаЗаказа.СуммаЗатрат                  = НоваяСтрокаЗаказа.ПлановоеРасстояниеКТочке * НоваяСтрокаЗаказа.ЗатратыНаКМ;
		НоваяСтрокаЗаказа.СтатусДоставки               = Статус_Заказ_Принят;

	КонецЦикла;

	Попытка
		ДокументРейс.ДополнительныеСвойства.Вставить("ИгнорироватьОбновлениеВодителя");
		ДокументРейс.Записать();
	Исключение
		ДокументРейс.Записать();
	КонецПопытки;

КонецПроцедуры
